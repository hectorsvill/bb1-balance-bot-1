# Build output from arduino-cli (prebuilt .uf2 files live in firmware/uf2/ and ARE tracked)
build/
# Written by tools/flash.py before each compile (firmware/bb1/version.h)
build_id.h

# Photos: iPhone HEIC files can carry GPS location in their metadata
images/

# Secrets: Wi-Fi credentials, keys, tokens (keep these out of git)
.env
.env.*
secrets.h
arduino_secrets.h
*secret*
# ...except the template, which has no real secrets
!secrets.example.h
*.key
*.pem
*.p12
credentials*

# OS and editor clutter
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Python virtual environment for tools/ (rebuilt from tools/requirements.txt)
venv/
__pycache__/

# Recorded runs: logs is a link to the private repo bb1-private/logs (no trailing slash: a link isn't a folder to git)
logs
graphify-out/

# SQLite catalogs (tools/runs_db.py, logs/runs.sqlite): rebuilt from the CSVs, never committed
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
